  "nodes": [
    {
      "id": "90439c3d-b69c-4eca-a9d0-0d4e9e10fe82",
      "name": "Delivery Callback Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.3,
      "position": [240, 300],
      "parameters": {
        "updates": ["callback_query"],
        "additionalFields": {
          "chatIds": "<__PLACEHOLDER_VALUE__Chat ID restrito de Anderson (Restrict to Chat IDs)__>",
          "userIds": "<__PLACEHOLDER_VALUE__User ID restrito de Anderson (Restrict to User IDs)__>"
        }
      },
      "webhookId": "f59a8a99-c64d-4cee-ad7e-a7e791347c5d"
    },
    {
      "id": "2348b760-8c01-4a6f-a8fd-6789ec712d87",
      "name": "Answer Callback Query",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [540, 300],
      "parameters": { "resource": "callback", "operation": "answerQuery", "queryId": "={{ $json.callback_query.id }}" },
      "webhookId": "9a490bb1-75b5-4ffb-aa9c-5a5fa41984f1"
    },
    {
      "id": "334a80b8-97a4-49c5-b776-065466c89d2d",
      "name": "Parse Callback Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [840, 300],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            { "id": "p1", "name": "callback_query_id", "value": "={{ $('Delivery Callback Trigger').item.json.callback_query.id }}", "type": "string" },
            { "id": "p2", "name": "category", "value": "={{ $('Delivery Callback Trigger').item.json.callback_query.data.split(':')[0] }}", "type": "string" },
            { "id": "p3", "name": "action_letter", "value": "={{ $('Delivery Callback Trigger').item.json.callback_query.data.split(':')[1] }}", "type": "string" },
            { "id": "p4", "name": "action_token", "value": "={{ $('Delivery Callback Trigger').item.json.callback_query.data.split(':')[2] }}", "type": "string" },
            { "id": "p5", "name": "action", "value": "={{ { S: 'MARCAR_ENVIADA', B: 'VOLTAR_EDITAR' }[$('Delivery Callback Trigger').item.json.callback_query.data.split(':')[1]] ?? '' }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "02d6f9e2-976a-441c-9899-cf856ba58b6b",
      "name": "Is Delivery Category?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1140, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.category }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "a" },
            { "leftValue": "={{ $json.action }}", "operator": { "type": "string", "operation": "notEmpty" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "76e7cfb3-bf58-4326-96fc-d5df71221128",
      "name": "Route by Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [1440, 300],
      "parameters": {
        "rules": {
          "values": [
            { "outputKey": "marcar_enviada", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.action }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "MARCAR_ENVIADA" }], "combinator": "and" } },
            { "outputKey": "voltar_editar", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.action }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "VOLTAR_EDITAR" }], "combinator": "and" } }
          ]
        },
        "options": { "fallbackOutput": "none" }
      }
    },
    {
      "id": "799753e6-2b70-4251-832c-b97c24294327",
      "name": "Compute First Followup Date",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1740, 180],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": { "assignments": [ { "id": "ff1", "name": "first_followup_at", "value": "={{ $now.plus(3, 'days').toISO() }}", "type": "string" } ] }
      }
    },
    {
      "id": "62ce1b0d-8939-4558-9513-11a1840c51c9",
      "name": "Mark Message Sent (Enviada)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [2040, 180],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT * FROM rufino_linkedin.mark_message_sent(\n    p_action_token       => $1,\n    p_action             => 'MARCAR_ENVIADA',\n    p_actor              => 'telegram:anderson',\n    p_callback_query_id  => $2,\n    p_first_followup_at  => $3::timestamptz,\n    p_workflow_name      => 'WF-04',\n    p_execution_id       => $4\n);",
        "options": { "queryReplacement": "={{ [$json.action_token, $json.callback_query_id, $json.first_followup_at, $execution.id] }}" }
      },
      "credentials": { "postgres": { "id": "DgnSAHo0I8CRFwci", "name": "Rufino LinkedIn DEV" } }
    },
    {
      "id": "1f938f7e-c363-414e-9bde-0118edaaa1fb",
